// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum RolUsuario {
  admin
  funcionario
  apoderado
  superadmin
}

enum EstadoQr {
  activo
  revocado
}

enum EstadoHallazgo {
  reportado
  retirado
  descartado
}

enum CanalNotificacion {
  email
  whatsapp
  web
}

enum EstadoNotificacion {
  pendiente
  enviada
  fallida
}

model Colegio {
  id             Int      @id @default(autoincrement())
  nombre         String
  codigoRegistro String   @unique @map("codigo_registro")
  activo         Boolean  @default(true)
  createdAt      DateTime @default(now()) @map("created_at")

  usuarios    Usuario[]
  estudiantes Estudiante[]
  qrCodigos   QrCodigo[]
  ubicaciones Ubicacion[]

  @@map("colegio")
}

model Usuario {
  id           Int        @id @default(autoincrement())
  email        String     @unique
  passwordHash String     @map("password_hash")
  nombre       String
  rol          RolUsuario
  // colegioId es NULL únicamente para rol = superadmin (administrador
  // global de plataforma, no pertenece a ningún colegio). Para admin,
  // funcionario y apoderado es obligatorio. Prisma/MariaDB no expresan
  // bien un CHECK condicional rol -> colegioId, así que esta regla se
  // valida a nivel de aplicación (no acá en el schema).
  colegioId    Int?       @map("colegio_id")
  activo       Boolean    @default(true)
  createdAt    DateTime   @default(now()) @map("created_at")

  // Verificación de correo para el auto-registro de apoderados (admin y
  // funcionario se crean manualmente y quedan exentos del chequeo en
  // lib/auth.ts). El token vive directo acá, no en una tabla aparte: es
  // 1:1 y no necesita historial — mismo criterio que QrCodigo.token.
  // Reenviar el correo de verificación simplemente sobrescribe estos dos
  // campos.
  emailVerificado         Boolean   @default(false) @map("email_verificado")
  tokenVerificacion       String?   @unique @map("token_verificacion")
  tokenVerificacionExpira DateTime? @map("token_verificacion_expira")

  colegio Colegio? @relation(fields: [colegioId], references: [id])

  hijos               Estudiante[] @relation("ApoderadoDeEstudiante")
  hallazgosReportados Hallazgo[]   @relation("HallazgoReportadoPor")
  hallazgosRetirados  Hallazgo[]   @relation("HallazgoRetiradoPor")

  @@index([colegioId])
  @@map("usuario")
}

model Estudiante {
  id          Int      @id @default(autoincrement())
  nombre      String
  curso       String?
  apoderadoId Int      @map("apoderado_id")
  colegioId   Int      @map("colegio_id")
  activo      Boolean  @default(true)
  createdAt   DateTime @default(now()) @map("created_at")

  apoderado Usuario    @relation("ApoderadoDeEstudiante", fields: [apoderadoId], references: [id])
  colegio   Colegio    @relation(fields: [colegioId], references: [id])
  qrCodigos QrCodigo[]

  @@index([apoderadoId])
  @@index([colegioId])
  @@map("estudiante")
}

model QrCodigo {
  id           Int      @id @default(autoincrement())
  estudianteId Int      @map("estudiante_id")
  colegioId    Int      @map("colegio_id")
  token        String   @unique
  etiqueta     String?
  estado       EstadoQr @default(activo)
  createdAt    DateTime @default(now()) @map("created_at")

  estudiante Estudiante @relation(fields: [estudianteId], references: [id])
  colegio    Colegio    @relation(fields: [colegioId], references: [id])
  hallazgos  Hallazgo[]

  @@index([estudianteId])
  @@index([colegioId])
  @@map("qr_codigo")
}

model Ubicacion {
  id        Int     @id @default(autoincrement())
  colegioId Int     @map("colegio_id")
  nombre    String
  activo    Boolean @default(true)
  latitud   Float?
  longitud  Float?

  colegio   Colegio    @relation(fields: [colegioId], references: [id])
  hallazgos Hallazgo[]

  @@index([colegioId])
  @@map("ubicacion")
}

model Hallazgo {
  id             Int            @id @default(autoincrement())
  qrCodigoId     Int            @map("qr_codigo_id")
  ubicacionId    Int            @map("ubicacion_id")
  reportadoPorId Int            @map("reportado_por")
  nota           String?
  estado         EstadoHallazgo @default(reportado)
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")

  // Retiro con código (capa 1): código corto entregado al apoderado por
  // email, sin nombres visibles para el funcionario en ningún paso hasta
  // la entrega. Único a nivel global (no solo "entre abiertos"): mismo
  // criterio que QrCodigo.token — con 6 caracteres sobre un alfabeto sin
  // ambigüedades el espacio es enorme, y así MySQL puede expresarlo como
  // constraint dura sin necesitar un índice parcial (que no soporta
  // bien). La búsqueda por código igual filtra por estado = reportado,
  // así que nunca hay ambigüedad real aunque un código viejo ya retirado
  // coincida por casualidad con uno nuevo (astronómicamente improbable
  // de todas formas). Hallazgos creados antes de este campo quedan con
  // codigoRetiro: null y siguen resolviéndose solo por "Marcar retirado".
  codigoRetiro  String?   @unique @map("codigo_retiro")
  retiradoAt    DateTime? @map("retirado_at")
  retiradoPorId Int?      @map("retirado_por")

  qrCodigo    QrCodigo  @relation(fields: [qrCodigoId], references: [id])
  ubicacion   Ubicacion @relation(fields: [ubicacionId], references: [id])
  reportante  Usuario   @relation("HallazgoReportadoPor", fields: [reportadoPorId], references: [id])
  retiradoPor Usuario?  @relation("HallazgoRetiradoPor", fields: [retiradoPorId], references: [id])

  notificaciones Notificacion[]

  @@index([qrCodigoId])
  @@index([ubicacionId])
  @@index([reportadoPorId])
  @@index([retiradoPorId])
  @@map("hallazgo")
}

model Notificacion {
  id           Int                @id @default(autoincrement())
  hallazgoId   Int                @map("hallazgo_id")
  canal        CanalNotificacion
  destinatario String
  estado       EstadoNotificacion @default(pendiente)
  payload      Json
  enviadaAt    DateTime?          @map("enviada_at")
  createdAt    DateTime           @default(now()) @map("created_at")

  hallazgo Hallazgo @relation(fields: [hallazgoId], references: [id])

  @@index([hallazgoId])
  @@map("notificacion")
}
