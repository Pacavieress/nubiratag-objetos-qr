# MariaDB local (XAMPP). Crear la base "objetos_qr" en phpMyAdmin antes de
# migrar (charset utf8mb4, collation utf8mb4_unicode_ci).
DATABASE_URL="mysql://root:@localhost:3306/objetos_qr"

# Base URL usada para construir la URL que codifica cada QR (https://<host>/q/<token>).
NEXT_PUBLIC_APP_URL="http://localhost:3001"

# Auth.js (NextAuth v5) - secreto para firmar/cifrar JWT de sesión.
# Generar uno propio, por ejemplo: openssl rand -base64 32
AUTH_SECRET=""

# Seed del super admin (prisma/seed.ts). colegioId siempre null.
SEED_SUPERADMIN_EMAIL=""
SEED_SUPERADMIN_PASSWORD=""

# Seed del admin del colegio de prueba (prisma/seed.ts). colegioId
# siempre asignado — ya no es el super admin.
SEED_ADMIN_EMAIL=""
SEED_ADMIN_PASSWORD=""

# Seed del usuario funcionario de prueba (prisma/seed.ts).
SEED_FUNCIONARIO_EMAIL=""
SEED_FUNCIONARIO_PASSWORD=""

# Seed del usuario apoderado de prueba (prisma/seed.ts).
SEED_APODERADO_EMAIL=""
SEED_APODERADO_PASSWORD=""

# SMTP (Hostinger, mismo servidor que Nubira.cl) para el correo de
# verificación de registro (lib/email.ts).
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM=""
